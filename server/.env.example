# Server environment. Copy to server/.env for local development.
# Never commit real secrets.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins. Must be an explicit list,
# never "*". Production requires https origins with no localhost.
CORS_ORIGIN=http://localhost:5173

# Trust X-Forwarded-* from the platform proxy so req.ip (and IP rate limiting)
# sees the real client. Defaults to 1 hop for Render/Railway. Use "true" only
# for a fully trusted chain, or an IP/subnet list.
TRUST_PROXY=1

# MongoDB connection string. Production must use MongoDB Atlas, not localhost.
MONGO_URI=mongodb://127.0.0.1:27017/haven

# Use 32+ character random strings in production.
JWT_ACCESS_SECRET=dev-access-secret-change-me-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-chars-min

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Optional: local upload directory (defaults to server/uploads). Ignored when
# Cloudinary is configured. Point it at a persistent volume if you rely on it.
# UPLOAD_DIR=

# Cloudinary media storage. Set all three to upload images to Cloudinary.
# Leave all three unset to fall back to local disk (lost on redeploy).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional SMTP delivery. Without SMTP_HOST, emails are logged to the console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Haven <no-reply@haven.example>

# Brevo HTTP email API (use this on Render free tier, where SMTP ports are blocked)
# BREVO_API_KEY=
# SMTP_FROM must be a sender verified in Brevo, e.g. Haven <you@gmail.com>

# Used by `npm run seed:admin -w server` to create or update the first admin.
ADMIN_NAME=Haven Admin
ADMIN_EMAIL=admin@haven.test
ADMIN_PASSWORD=HavenAdmin123

# Seed demo accounts/listings and ensure the demo admin (admin@haven.test) on
# non-development builds. Set "true" on the demo environment only.
# ENABLE_DEMO_DATA=

# ---- Production (Render) ----
# NODE_ENV=production
# MONGO_URI=<MongoDB Atlas URI>
# JWT_ACCESS_SECRET=<random, 32+ chars>
# JWT_REFRESH_SECRET=<random, 32+ chars>
# CORS_ORIGIN=https://your-app.vercel.app   (https, no trailing slash)
# TRUST_PROXY=1
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET
# Do NOT set PORT on Render; Render provides it.
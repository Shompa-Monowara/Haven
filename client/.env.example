# Public site origin used for canonical URLs, Open Graph/Twitter metadata, and
# the generated sitemap and robots.txt.
#
# Required for production/CI builds: `client/scripts/prerender.mjs` fails the
# build when this is missing or still contains "example.com".
# Example: VITE_SITE_URL=https://www.your-domain.com
VITE_SITE_URL=

# Backend origin for Socket.io (real-time chat). Leave empty in local dev.
# Production example: VITE_SOCKET_URL=https://your-api.onrender.com
VITE_SOCKET_URL=

# Show the demo account helper box on the login page. Set "true" on the demo
# environment (requires a client rebuild). Leave unset to hide it in production.
# VITE_SHOW_DEMO_LOGIN=